{
    "name": "misterplan/reservations-app",
    "description": "Accommodation reservations management — technical test for MisterPlan (plain PHP, Twig, vanilla JS)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
